# CheckPC v3.70 external environment template
VLLM_URL=http://localhost:8000/v1
VLLM_MODEL=qwen25-coder-32b-q3
PIPELINE_JOBS_DIR=/opt/llm/jobs
PIPELINE_MAX_WORKERS=2
CHECKPC_MAX_INFLIGHT_LLM=9
PIPELINE_MAX_UPLOAD_MB=2048
PIPELINE_MAX_BATCH_FILES=32
PIPELINE_MAX_BATCH_TOTAL_MB=4096
PIPELINE_MAX_CONTEXT_CHARS=4000
PIPELINE_MAX_FOLDER_CHARS=120
PIPELINE_MAX_CHAT_CHARS=12000
CHECKPC_EXTERNAL_CMD_TIMEOUT_SEC=300
CHECKPC_MAX_EXTRACTED_FILES=20000
CHECKPC_MAX_EXTRACTED_MB=8192
# Background archive queue. One server process / one archive builder.
CHECKPC_ARCHIVE_QUEUE_MAX=16
CHECKPC_ARCHIVE_BUILD_TIMEOUT_SEC=3600
CHECKPC_ARCHIVE_LARGE_THRESHOLD_MB=2048
WEB_CONCURRENCY=1
PIPELINE_HTTP_PORT=8001
PIPELINE_HTTPS_PORT=443
# Fail-safe bind: unauthenticated deployments must remain on loopback.
PIPELINE_BIND_HOST=127.0.0.1
# Set to 1 only for a deliberately accepted remote HTTP deployment.
PIPELINE_ALLOW_INSECURE_REMOTE=0
# Optional HTTPS. Certificate and key must be configured together.
PIPELINE_SSL_CERT=
PIPELINE_SSL_KEY=
# Fixed-user HTTP Basic. Required for non-loopback bind.
PIPELINE_AUTH_USER=
PIPELINE_AUTH_PBKDF2=
# Legacy API key compatibility. Prefer Basic + TLS.
PIPELINE_API_KEY=
# v3.70 inherits the formally validated v3.69 numeric envelope; the new evidence policy remains validation-pending.
CHECKPC_BUDGET_PROFILE=v370
# Depth2 Step 4B bounded planner controls. Raise only with measured evidence.
CHECKPC_D2_PLANNER_TRIM_BATCH_MAX=8
CHECKPC_D2_PLANNER_FRONTIER_RESERVE=32
CHECKPC_D2_PLANNER_PROBE_LIMIT=1024
CHECKPC_D2_PLANNER_REPLAN_LIMIT=512
CHECKPC_D2_PLANNER_CANCEL_INTERVAL=4096
CHECKPC_D2_PLANNER_PROGRESS_INTERVAL=65536
CHECKPC_D2_PLANNER_TRIM_ITERATION_LIMIT=512

# Chat Lv.2 master switches. Keep both 0 until the deployment policy is accepted.
# Legacy CHAT_LV2_ENABLED=1 enables both when the individual switches are absent.
CHAT_LV2_ENABLED=0
CHAT_LV2_LOCAL_ENABLED=1
CHAT_LV2_VT_IOC_ENABLED=0
# off / local / local_vt_ioc. Individual jobs/case folders can override this in GUI.
CHAT_LV2_DEFAULT_POLICY=local
CHAT_LV2_MAX_CALLS=20
CHAT_MAX_TOOL_CALLS_PER_TURN=3
CHAT_MAX_TOOL_ITERATIONS=3
CHAT_INVESTIGATE_TIMEOUT_SEC=12
CHAT_INVESTIGATE_MAX_JOBS=200
CHAT_INVESTIGATE_DEFAULT_LIMIT=50
CHAT_INVESTIGATE_HARD_LIMIT=200
CHAT_CROSS_HOST_MAX_HITS=50
CHAT_CROSS_HOST_CURRENT_MAX_HITS=20
CHAT_CROSS_HOST_MAX_FILE_MB=20
CHAT_CROSS_HOST_MAX_TOTAL_MB=200
CHAT_CROSS_HOST_MAX_JOBS=200
CHAT_CROSS_HOST_MAX_FILES=400
CHAT_CROSS_HOST_TIMEOUT_SEC=8
# VirusTotal: chat sends only MD5/SHA-1/SHA-256, global-unicast IP, or FQDN.
# URL, path, filename, multicast/private/reserved/special-use IP, and sample upload
# are rejected before network access.
VT_API_KEY=
VT_PROXY=
VT_RATE_DELAY=0
CHAT_VT_TIMEOUT=30
CHAT_VT_CACHE_TTL_SEC=86400
CHAT_VT_CACHE_MAX_ENTRIES=2048
CHAT_VT_RETRY_429_MAX_SEC=60
# Bounded in-memory copy retained when the primary/fallback audit files cannot be written.
CHAT_AUDIT_FALLBACK_MAX_RECORDS=256

# Machine-readable test provenance. Use base117 for formal --release runs.
CHECKPC_TEST_ENV_LABEL=developer-local

# Formal --release only: directory containing the four comparison results
# and any SHA-bound approval files required to resolve REVIEW findings.
CHECKPC_COMPARISON_GATE_DIR=
